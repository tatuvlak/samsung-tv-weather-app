<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://example.com/tvweather"
        version="1.0.0">
  <tizen:application id="tvweather1.tvweather" package="tvweather1" required_version="2.3"/>
  <tizen:profile name="tv"/>
  <name>Świnka Pogodynka</name>
  <description>Weather station data display app</description>
  <author>Samsung TV Weather</author>
  <license>MIT</license>
  <icon src="icon.png"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/network.get"/>
  <access origin="*" subdomains="true"/>
  <!-- connect-src must list every host the app fetches from: the weather hub
       on the NAS, and Open-Meteo for the forecast panel. The hub's address is
       duplicated in config.js - change it in both places, or the fetch is
       blocked by policy rather than failing on the network, which looks
       nothing like an address problem from the TV's console.
       api.open-meteo.com was missing here before, so the forecast panel was
       relying on the policy not being enforced. -->
  <tizen:content-security-policy>
    default-src 'self';
    connect-src 'self' http://192.168.18.250:5000 https://api.open-meteo.com;
    script-src 'self' 'unsafe-inline' 'unsafe-eval';
    style-src 'self' 'unsafe-inline';
  </tizen:content-security-policy>
  <preference name="orient" value="landscape"/>
</widget>
